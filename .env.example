# =======================================================
# Swaranidhi Environment Configuration Template
# =======================================================

# Frontend Configuration (Vite)
VITE_API_BASE_URL=http://localhost:8080/api
VITE_API_URL=http://localhost:8080/api
VITE_ENABLE_MOCK_DATA=false

# Backend Server Configuration
SERVER_PORT=8080

# Database Configuration (PostgreSQL or local H2)
# For local H2 PostgreSQL compatibility (default zero-config):
# SPRING_DATASOURCE_URL=jdbc:h2:file:./data/swaranidhidb;MODE=PostgreSQL;DATABASE_TO_LOWER=TRUE;DEFAULT_NULL_ORDERING=HIGH
# For Docker / Production PostgreSQL:
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/swaranidhi_db
SPRING_DATASOURCE_USERNAME=swaranidhi_user
SPRING_DATASOURCE_PASSWORD=swaranidhi_pass123
POSTGRES_DB=swaranidhi_db
POSTGRES_USER=swaranidhi_user
POSTGRES_PASSWORD=swaranidhi_pass123

# JWT Security (Generate a secure key with: openssl rand -base64 48)
SWARANIDHI_JWT_SECRET=your-cryptographically-secure-random-256-bit-key-here
JWT_SECRET=your-cryptographically-secure-random-256-bit-key-here
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80,http://localhost
